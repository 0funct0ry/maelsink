---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<header
  class="sticky top-0 z-50 border-b backdrop-blur"
  style="background: rgba(255,255,255,0.86); border-color: var(--ms-border);"
>
  <div class="mx-auto flex h-16 max-w-[1160px] items-center gap-9 px-7">
    <div class="flex items-center gap-2.5">
      <div
        class="flex h-7 w-7 items-center justify-center rounded-lg"
        style="background: linear-gradient(155deg, var(--ms-accent) 0%, #8b7fff 100%); box-shadow: 0 3px 8px rgba(99,91,255,0.35);"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
          <path d="M3 6.5L12 13L21 6.5" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M3 6.5C3 5.4 3.9 4.5 5 4.5H19C20.1 4.5 21 5.4 21 6.5V15C21 17.5 18.5 20 15 20H9C5.5 20 3 17.5 3 15V6.5Z" stroke="white" stroke-width="1.8" stroke-linejoin="round"></path>
        </svg>
      </div>
      <span class="text-base font-bold" style="font-family: var(--ms-font-mono); color: var(--ms-text); letter-spacing: -0.02em;">maelsink</span>
    </div>

    <nav class="hidden items-center gap-7 sm:flex">
      <a href="#features" class="text-sm font-medium" style="color: var(--ms-text-soft);">Features</a>
      <a href="#how-it-works" class="text-sm font-medium" style="color: var(--ms-text-soft);">How it works</a>
      <a href="#install" class="text-sm font-medium" style="color: var(--ms-text-soft);">Install</a>
      <a href={`${base}docs/`} class="text-sm font-medium" style="color: var(--ms-text-soft);">Docs</a>
    </nav>

    <div class="ml-auto flex items-center gap-2.5">
      <a
        href="https://github.com/0funct0ry/maelsink"
        class="hidden items-center gap-2 rounded-lg border px-3.5 py-2 text-[13px] font-semibold sm:inline-flex"
        style="color: var(--ms-text); border-color: var(--ms-border); background: var(--ms-bg);"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" class="h-[15px] w-[15px]"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.5 2.87 8.32 6.84 9.67.5.1.68-.22.68-.48 0-.24-.01-1.02-.01-1.85-2.5.55-3.03-1.08-3.03-1.08-.41-1.05-1-1.32-1-1.32-.82-.56.06-.55.06-.55.9.06 1.38.94 1.38.94.8 1.38 2.1.98 2.61.75.08-.58.31-.98.56-1.2-2-.23-4.1-1-4.1-4.45 0-.98.35-1.79.92-2.42-.09-.23-.4-1.16.09-2.42 0 0 .75-.24 2.47.92a8.5 8.5 0 014.5 0c1.72-1.16 2.47-.92 2.47-.92.49 1.26.18 2.19.09 2.42.57.63.92 1.44.92 2.42 0 3.46-2.1 4.22-4.1 4.44.33.28.61.83.61 1.68 0 1.21-.01 2.19-.01 2.49 0 .27.18.58.69.48A10.02 10.02 0 0022 12.25C22 6.58 17.52 2 12 2z"></path></svg>
        GitHub
      </a>
      <a
        href="https://github.com/0funct0ry/maelsink/releases/latest"
        class="inline-flex items-center gap-2 rounded-lg px-3.5 py-2 text-[13px] font-semibold text-white"
        style="background: var(--ms-accent); box-shadow: 0 1px 2px rgba(26,31,54,0.08), 0 4px 10px rgba(99,91,255,0.28);"
      >
        <svg viewBox="0 0 24 24" fill="none" class="h-[15px] w-[15px]"><path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        Download
      </a>
    </div>
  </div>
</header>
