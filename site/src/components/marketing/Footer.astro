---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const year = new Date().getFullYear();
---

<footer class="py-14 sm:py-16">
  <div class="mx-auto max-w-[1160px] px-7">
    <div class="mb-10 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-2">
          <div
            class="flex h-6 w-6 items-center justify-center rounded-lg"
            style="background: linear-gradient(155deg, var(--ms-accent) 0%, #8b7fff 100%);"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none">
              <path d="M3 6.5L12 13L21 6.5" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M3 6.5C3 5.4 3.9 4.5 5 4.5H19C20.1 4.5 21 5.4 21 6.5V15C21 17.5 18.5 20 15 20H9C5.5 20 3 17.5 3 15V6.5Z" stroke="white" stroke-width="1.8" stroke-linejoin="round"></path>
            </svg>
          </div>
          <span class="text-base font-bold" style="font-family: var(--ms-font-mono); color: var(--ms-text); letter-spacing: -0.02em;">maelsink</span>
        </div>
        <p class="mt-3 max-w-[220px] text-[13.5px] leading-relaxed" style="color: #9aa1b1;">
          A minimal, single-binary fake SMTP server for developers. Capture, inspect,
          and never send a test email to a real inbox again.
        </p>
      </div>

      <div>
        <div class="mb-3.5 text-xs font-bold uppercase tracking-wider" style="color: #9aa1b1;">Product</div>
        <a href="#features" class="mb-2.5 block text-[13.5px]" style="color: var(--ms-text-soft);">Features</a>
        <a href="#install" class="mb-2.5 block text-[13.5px]" style="color: var(--ms-text-soft);">Install</a>
        <a href={`${base}docs/`} class="mb-2.5 block text-[13.5px]" style="color: var(--ms-text-soft);">Documentation</a>
      </div>

      <div>
        <div class="mb-3.5 text-xs font-bold uppercase tracking-wider" style="color: #9aa1b1;">Resources</div>
        <a href={`${base}docs/`} class="mb-2.5 block text-[13.5px]" style="color: var(--ms-text-soft);">Docs</a>
        <a href={`${base}docs/cli-reference`} class="mb-2.5 block text-[13.5px]" style="color: var(--ms-text-soft);">CLI reference</a>
        <a href={`${base}docs/rest-api-reference`} class="mb-2.5 block text-[13.5px]" style="color: var(--ms-text-soft);">REST API reference</a>
      </div>

      <div>
        <div class="mb-3.5 text-xs font-bold uppercase tracking-wider" style="color: #9aa1b1;">Community</div>
        <a href="https://github.com/0funct0ry/maelsink" class="mb-2.5 block text-[13.5px]" style="color: var(--ms-text-soft);">GitHub</a>
        <a href="https://github.com/0funct0ry/maelsink/issues" class="mb-2.5 block text-[13.5px]" style="color: var(--ms-text-soft);">Issues</a>
        <a href="https://github.com/0funct0ry/maelsink/blob/main/LICENSE" class="mb-2.5 block text-[13.5px]" style="color: var(--ms-text-soft);">License (MIT)</a>
      </div>
    </div>

    <div class="flex flex-col gap-3 border-t pt-6 text-[12.5px] sm:flex-row sm:items-center sm:justify-between" style="border-color: var(--ms-border); color: #9aa1b1;">
      <span>&copy; {year} maelsink. Open source under the MIT license.</span>
      <a href="https://github.com/0funct0ry/maelsink" style="color: #9aa1b1;">
        <svg viewBox="0 0 24 24" fill="currentColor" class="h-[17px] w-[17px]"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.5 2.87 8.32 6.84 9.67.5.1.68-.22.68-.48 0-.24-.01-1.02-.01-1.85-2.5.55-3.03-1.08-3.03-1.08-.41-1.05-1-1.32-1-1.32-.82-.56.06-.55.06-.55.9.06 1.38.94 1.38.94.8 1.38 2.1.98 2.61.75.08-.58.31-.98.56-1.2-2-.23-4.1-1-4.1-4.45 0-.98.35-1.79.92-2.42-.09-.23-.4-1.16.09-2.42 0 0 .75-.24 2.47.92a8.5 8.5 0 014.5 0c1.72-1.16 2.47-.92 2.47-.92.49 1.26.18 2.19.09 2.42.57.63.92 1.44.92 2.42 0 3.46-2.1 4.22-4.1 4.44.33.28.61.83.61 1.68 0 1.21-.01 2.19-.01 2.49 0 .27.18.58.69.48A10.02 10.02 0 0022 12.25C22 6.58 17.52 2 12 2z"></path></svg>
      </a>
    </div>
  </div>
</footer>
