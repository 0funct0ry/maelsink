---
---

<section class="py-14 sm:py-20">
  <div class="mx-auto max-w-[1160px] px-7">
    <div
      class="mx-auto max-w-[820px] rounded-3xl px-8 py-16 text-center text-white sm:px-14"
      style="background: linear-gradient(160deg, #1a1f36 0%, #2b2560 100%);"
    >
      <h2 class="mb-3.5 text-[26px] font-bold tracking-tight sm:text-[32px]" style="letter-spacing: -0.02em;">
        Prevent accidental email delivery to real recipients
      </h2>
      <p class="mx-auto mb-7 max-w-[420px] text-[15.5px]" style="color: #c6cbe0;">
        Maelsink runs as a single binary and exposes three network ports without
        sending any real emails. It can be installed and running within minutes.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href="https://github.com/0funct0ry/maelsink/releases/latest"
          class="inline-flex items-center gap-2 rounded-lg px-6 py-3.5 text-[15px] font-semibold transition hover:-translate-y-0.5"
          style="background: #fff; color: var(--ms-text);"
        >
          <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4"><path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          Download maelsink
        </a>
        <a
          href="https://github.com/0funct0ry/maelsink"
          class="inline-flex items-center gap-2 rounded-lg border px-6 py-3.5 text-[15px] font-semibold transition"
          style="border-color: rgba(255,255,255,0.25); color: #fff;"
        >
          Star on GitHub
        </a>
      </div>
    </div>
  </div>
</section>
